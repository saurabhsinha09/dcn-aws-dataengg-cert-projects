        </mxCell>
        <mxCell id="sf-step1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3F51B5;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1A237E;align=left;spacingLeft=15;" value="1. &lt;b&gt;DataValidation&lt;/b&gt; (Type: Task)&#xa;Resource: arn:aws:states:::ecs:runTask.sync&#xa;• Cluster: dcn-ecommerce-data-cluster&#xa;• TaskDefinition: task-data-validation:2 (FARGATE)&#xa;• Overrides: TASK_TOKEN = $$.Task.Token&#xa;• ResultPath: $.taskOutput" vertex="1">
          <mxGeometry height="110" width="440" x="580" y="295" as="geometry" />
        </mxCell>
        <mxCell id="sf-step2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFA000;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E65100;align=center;" value="2. &lt;b&gt;CheckCondition&lt;/b&gt;&#xa;(Type: Choice)&#xa;orders=1 AND order_items=1&#xa;AND products=1?" vertex="1">
