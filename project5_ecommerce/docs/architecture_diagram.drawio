        <mxCell id="sf-title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C71325;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#FFFFFF;fontFace=Arial;" value="Step Functions DAG Workflow &amp;amp; Conditional Task Execution" vertex="1">
          <mxGeometry height="40" width="1520" x="40" y="130" as="geometry" />
        </mxCell>
        <mxCell id="sf-start" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;strokeWidth=2;fontSize=13;fontStyle=1;fontFace=Arial;arcSize=50;" value="EventBridge Trigger&#xa;(S3 Object Created)" vertex="1">
