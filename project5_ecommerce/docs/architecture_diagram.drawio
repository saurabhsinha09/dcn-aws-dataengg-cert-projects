        </mxCell>
        <mxCell id="pl-c1-out2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFA000;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E65100;align=left;spacingLeft=10;" value="🔑 &lt;b&gt;Step Functions Task Token Callback:&lt;/b&gt;&#xa;Returns $.taskOutput JSON to Choice State CheckCondition" vertex="1">
          <mxGeometry height="65" width="450" x="930" y="362" as="geometry" />
        </mxCell>
        <mxCell id="pl-c2-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#009688;strokeWidth=2;fontSize=14;fontStyle=1;fontFace=Arial;arcSize=3;" value="" vertex="1">
          <mxGeometry height="370" width="1340" x="80" y="505" as="geometry" />
        </mxCell>
        <mxCell id="pl-c2-hdr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#009688;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#FFFFFF;fontFace=Arial;" value="Container 2: etl_aggregations (Task Definition: task-etl-calculations)" vertex="1">
          <mxGeometry height="35" width="1340" x="80" y="505" as="geometry" />
        </mxCell>
        <mxCell id="pl-c2-in" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#1B5E20;" value="📥 Validated CSVs from S3:&#xa;• ecommerce-data/orders/&#xa;• ecommerce-data/order_items/&#xa;• ecommerce-data/products/" vertex="1">
          <mxGeometry height="90" width="240" x="108" y="635" as="geometry" />
        </mxCell>
        <mxCell id="pl-c2-logic" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#009688;strokeWidth=2;fontSize=12;fontColor=#004D40;align=left;spacingLeft=15;" value="&lt;b&gt;ETL Aggregation Container Logic:&lt;/b&gt;&lt;br&gt;1. Reads validated CSVs via AWS Wrangler (awswrangler.s3.read_csv).&lt;br&gt;2. Performs inner join: orders + order_items + products.&lt;br&gt;3. Computes Category KPIs: daily revenue, avg order value, avg return rate.&lt;br&gt;4. Computes Daily Order KPIs: total revenue, orders, items sold, return rate.&lt;br&gt;5. Upserts KPI metrics directly into DynamoDB NoSQL tables.&lt;br&gt;6. Archives processed CSVs to ecommerce-data/archived." vertex="1">
