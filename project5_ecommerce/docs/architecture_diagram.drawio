          <mxGeometry height="65" width="450" x="941" y="573" as="geometry" />
        </mxCell>
        <mxCell id="pl-c2-out2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#8D6E63;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#4E342E;align=left;spacingLeft=10;" value="📦 &lt;b&gt;S3 Archive Migration:&lt;/b&gt;&#xa;Moves processed CSV files to s3://.../ecommerce-data/archived/" vertex="1">
