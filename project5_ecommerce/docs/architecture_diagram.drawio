        </mxCell>
        <mxCell id="pl-c1-in" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#E65100;" value="📥 s3://.../ecommerce-data/new/&#xa;• orders_YYYYMMDD.csv&#xa;• order_items_YYYYMMDD.csv&#xa;• products_YYYYMMDD.csv" vertex="1">
          <mxGeometry height="90" width="240" x="103" y="258" as="geometry" />
