  <diagram id="page-dataflow" name="Detailed Pipeline &amp; Transformation Workflow">
    <mxGraphModel dx="1492" dy="564" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="df-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#DDDDDD;strokeWidth=1;arcSize=2;" value="" vertex="1">
          <mxGeometry height="560" width="1420" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="df-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="70" width="1420" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="df-3" parent="1" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#FF9900;fontFace=Arial;" value="aws" vertex="1">
          <mxGeometry height="36" width="60" x="70" y="52" as="geometry" />
        </mxCell>
        <mxCell id="df-4" parent="1" style="text;html=1;fontSize=18;fontColor=#FFFFFF;fontFace=Arial;align=left;" value="📊 AWS Lambda Record-Level In-Flight Transformation &amp;amp; Firehose Delivery Workflow" vertex="1">
          <mxGeometry height="36" width="1100" x="150" y="54" as="geometry" />
        </mxCell>
        <mxCell id="df-in" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E65100;" value="📡 Kinesis Firehose Micro-Batch&#xa;---------------------------------&#xa;• Receives batch of JSON records&#xa;• Encoded in Base64" vertex="1">
          <mxGeometry height="110" width="216" x="54" y="200" as="geometry" />
        </mxCell>
        <mxCell id="df-s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#0D47A1;" value="1. Decode &amp;amp; Parse&#xa;---------------------------------&#xa;• base64.b64decode(record[&#39;data&#39;])&#xa;• json.loads(payload_str)" vertex="1">
          <mxGeometry height="110" width="195" x="375" y="200" as="geometry" />
        </mxCell>
        <mxCell id="df-s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1B5E20;align=left;spacingLeft=10;" value="2. Derivation Logic (Enrichment):&#xa;---------------------------------&#xa;• &lt;b&gt;is_mobile:&lt;/b&gt;&#xa;  Checks browser for [&#39;Mobile&#39;, &#39;iPhone&#39;, &#39;Android&#39;, &#39;iPad&#39;]&#xa;  → Set &#39;Yes&#39; if found, else &#39;No&#39;&#xa;&#xa;• &lt;b&gt;traffic_source_category:&lt;/b&gt;&#xa;  Google/Bing → &#39;Search Engine&#39;&#xa;  Facebook/YouTube → &#39;Social Media&#39;&#xa;  Email → &#39;Email&#39;, Default → &#39;Direct&#39;" vertex="1">
          <mxGeometry height="180" width="255" x="705" y="165" as="geometry" />
        </mxCell>
        <mxCell id="df-s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFA000;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#FF6F00;" value="3. Format &amp;amp; Base64 Encode&#xa;---------------------------------&#xa;• Quotes every field into CSV row:&#xa;  &lt;i&gt;&quot;id&quot;,&quot;user_id&quot;,&quot;session_id&quot;,...,&quot;is_mobile&quot;,&quot;traffic_source_category&quot;...&lt;/i&gt;&#xa;• base64.b64encode(csv_str)&#xa;• Assigns result: &#39;Ok&#39;, recordId" vertex="1">
          <mxGeometry height="140" width="370" x="1070" y="185" as="geometry" />
        </mxCell>
        <mxCell id="df-deliv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#4A148C;align=left;spacingLeft=15;" value="🚚 &lt;b&gt;Firehose Automated Delivery &amp;amp; Redshift Loading:&lt;/b&gt;&#xa;--------------------------------------------------------------------------------------------------&#xa;1. Firehose receives enriched CSV payload response with result: &#39;Ok&#39;.&#xa;2. Firehose buffers micro-batch and writes CSV files to S3 staging bucket (&lt;i&gt;s3://dcn-dataengg&lt;/i&gt;).&#xa;3. Firehose triggers automated &lt;b&gt;COPY&lt;/b&gt; command into Amazon Redshift Serverless table &lt;b&gt;prod_schema.events&lt;/b&gt;." vertex="1">
          <mxGeometry height="130" width="1290" x="70" y="440" as="geometry" />
        </mxCell>
        <mxCell id="df-c1" edge="1" parent="1" source="df-in" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#37474F;strokeWidth=2;" target="df-s1" value="Batch Record">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="df-c2" edge="1" parent="1" source="df-s1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#37474F;strokeWidth=2;" target="df-s2" value="Parsed JSON">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="df-c3" edge="1" parent="1" source="df-s2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#37474F;strokeWidth=2;" target="df-s3" value="Enriched Dict">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="df-c4" edge="1" parent="1" source="df-s3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#37474F;strokeWidth=2;" target="df-deliv" value="Firehose Result Payload">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1200" y="380" />
              <mxPoint x="715" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-redshift" name="Redshift Serverless &amp; Data Warehouse Schema">
    <mxGraphModel dx="1492" dy="564" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rs-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#DDDDDD;strokeWidth=1;arcSize=2;" value="" vertex="1">
          <mxGeometry height="680" width="1420" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="rs-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="70" width="1420" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="rs-3" parent="1" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#FF9900;fontFace=Arial;" value="aws" vertex="1">
          <mxGeometry height="36" width="60" x="70" y="52" as="geometry" />
        </mxCell>
        <mxCell id="rs-4" parent="1" style="text;html=1;fontSize=18;fontColor=#FFFFFF;fontFace=Arial;align=left;" value="🗄️ Amazon Redshift Serverless Database Architecture &amp;amp; Schema Design" vertex="1">
          <mxGeometry height="36" width="1100" x="150" y="54" as="geometry" />
        </mxCell>
        <mxCell id="rs-info" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#4A148C;align=left;spacingLeft=15;" value="🏢 &lt;b&gt;Redshift Serverless Environment Specifications:&lt;/b&gt;&#xa;-----------------------------------------------------------&#xa;• &lt;b&gt;Database Name:&lt;/b&gt; clickstream_db&#xa;• &lt;b&gt;Database Schema:&lt;/b&gt; prod_schema&#xa;• &lt;b&gt;Target Table:&lt;/b&gt; events&#xa;• &lt;b&gt;Region:&lt;/b&gt; ap-south-1" vertex="1">
          <mxGeometry height="140" width="400" x="80" y="254" as="geometry" />
        </mxCell>
        <mxCell id="rs-tbl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0D47A1;align=left;spacingLeft=15;" value="📊 &lt;b&gt;Target Table Schema:&lt;/b&gt; &lt;i&gt;prod_schema.events&lt;/i&gt;&#xa;------------------------------------------------------------------------------------------&#xa;1. &lt;b&gt;id&lt;/b&gt; (BIGINT) - Unique Event Identifier&#xa;2. &lt;b&gt;user_id&lt;/b&gt; (BIGINT) - User ID&#xa;3. &lt;b&gt;session_id&lt;/b&gt; (CHAR(36)) - Unique Session Identifier&#xa;4. &lt;b&gt;ip_address&lt;/b&gt; (VARCHAR(50)) - Client IP Address&#xa;5. &lt;b&gt;city&lt;/b&gt; (VARCHAR(255)) - Geolocation City&#xa;6. &lt;b&gt;state&lt;/b&gt; (VARCHAR(255)) - Geolocation State&#xa;7. &lt;b&gt;browser&lt;/b&gt; (VARCHAR(50)) - Client User-Agent Browser String&#xa;8. ⭐ &lt;b&gt;is_mobile&lt;/b&gt; (VARCHAR(3)) - Enriched Device Flag (&#39;Yes&#39;/&#39;No&#39;)&#xa;9. &lt;b&gt;traffic_source&lt;/b&gt; (VARCHAR(50)) - Referrer Source URL&#xa;10. ⭐ &lt;b&gt;traffic_source_category&lt;/b&gt; (VARCHAR(50)) - Enriched Traffic Category&#xa;11. &lt;b&gt;uri&lt;/b&gt; (VARCHAR(255)) - Visited Page Path&#xa;12. &lt;b&gt;event_type&lt;/b&gt; (VARCHAR(50)) - User Action Type (&#39;pageview&#39;, &#39;click&#39;)" vertex="1">
          <mxGeometry height="330" width="850" x="520" y="160" as="geometry" />
        </mxCell>
        <mxCell id="rs-uc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1B5E20;align=left;spacingLeft=15;" value="📈 &lt;b&gt;Analytics &amp;amp; Business Intelligence Queries Supported:&lt;/b&gt;&#xa;------------------------------------------------------------------------------------------------------------------------------------------&#xa;• &lt;b&gt;Device Segment Analysis:&lt;/b&gt; &lt;i&gt;SELECT is_mobile, COUNT(*) FROM prod_schema.events GROUP BY is_mobile;&lt;/i&gt;&#xa;• &lt;b&gt;Traffic Attribution Modeling:&lt;/b&gt; &lt;i&gt;SELECT traffic_source_category, COUNT(DISTINCT user_id) FROM prod_schema.events GROUP BY 1;&lt;/i&gt;&#xa;• &lt;b&gt;User Funnel &amp;amp; Pageview Trends:&lt;/b&gt; &lt;i&gt;SELECT uri, event_type, COUNT(*) FROM prod_schema.events GROUP BY uri, event_type;&lt;/i&gt;" vertex="1">
          <mxGeometry height="160" width="1290" x="80" y="520" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
